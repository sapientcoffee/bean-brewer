{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoffeeMoodRecipe",
  "description": "Schema for coffee mood recommendation recipe contracts",
  "type": "object",
  "required": [
    "mood_id",
    "name",
    "tagline",
    "coffee_origin",
    "roast_level",
    "brew_method",
    "ratio",
    "water_temp_c",
    "grind_size",
    "tasting_notes",
    "brew_seconds",
    "lore"
  ],
  "properties": {
    "mood_id": { "type": "string" },
    "name": { "type": "string" },
    "tagline": { "type": "string" },
    "coffee_origin": { "type": "string" },
    "roast_level": { "type": "string", "enum": ["Light", "Medium-Light", "Medium", "Medium-Dark", "Dark"] },
    "brew_method": { "type": "string" },
    "ratio": { "type": "number", "minimum": 1, "maximum": 30 },
    "water_temp_c": { "type": "integer", "minimum": 60, "maximum": 100 },
    "grind_size": { "type": "string" },
    "tasting_notes": { "type": "array", "items": { "type": "string" } },
    "brew_seconds": { "type": "integer", "minimum": 30, "maximum": 600 },
    "lore": { "type": "string" }
  }
}
